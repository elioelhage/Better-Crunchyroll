{
  "manifest_version": 3,
  "name": "Better Crunchyroll",
  "version": "0.2.30",
  "description": "Improves the Crunchyroll watch experience with a persistent control panel, cleaner watch-page layout, and a streamlined Discover page.",
  "action": {"default_popup": "popup.html", "default_title": "Better Crunchyroll"},
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.crunchyroll.com/*"],
  "content_scripts": [{"matches": ["*://*.crunchyroll.com/*"], "js": ["crunchyroll-content.js", "v221.js", "v230.js"], "run_at": "document_start"}],
  "icons": {"16": "icons/icon128.png", "32": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png"},
  "web_accessible_resources": [{"resources": ["icons/back-button.svg", "icons/episodes.svg"], "matches": ["*://*.crunchyroll.com/*"]}]
}
